# Unified dotfiles utility tool — single entry point for all utility scripts.

import os
import platform
import sys
from pathlib import Path

VERSION    = "2.0.0"
SCRIPT_DIR = Path(__file__).parent.resolve()

# ──────────────────────────────────────────────────────────────────────────────
# Dispatch helpers
# ──────────────────────────────────────────────────────────────────────────────

def _exec_python(script: str, args: list[str]) -> None:
    """Replace the current process with a Python script in SCRIPT_DIR."""
    path = SCRIPT_DIR / script
    if not path.exists():
        print(f"Error: script not found: {path}", file=sys.stderr)
        sys.exit(1)
    os.execvp(sys.executable, [sys.executable, str(path)] + args)


def _exec_shell(script: str, args: list[str]) -> None:
    """Replace the current process with a shell script in SCRIPT_DIR."""
    path = SCRIPT_DIR / script
    if not path.exists():
        print(f"Error: script not found: {path}", file=sys.stderr)
        sys.exit(1)
    os.execvp(str(path), [str(path)] + args)

# ──────────────────────────────────────────────────────────────────────────────
# Commands
# ──────────────────────────────────────────────────────────────────────────────

def cmd_cleanup(args: list[str]) -> None:
    _exec_python("cleanup.py", args)


def cmd_ssh_keygen(args: list[str]) -> None:
    _exec_shell("_setup_ssh.sh", args)


def cmd_detect_os(_args: list[str]) -> None:
    system  = platform.system()
    machine = platform.machine()
    version = platform.release()

    if system == "Darwin":
        label = "macOS (Apple Silicon)" if machine == "arm64" else "macOS (Intel)"
    elif system == "Linux":
        label = "Linux (ARM)" if machine in ("aarch64", "arm64") else "Linux (x86_64)"
    else:
        label = f"Unknown: {system}"

    print("Operating System Detection")
    print("==========================")
    print(f"OS Type:     {label}")
    print(f"Kernel:      {system}")
    print(f"Version:     {version}")
    print(f"Arch:        {machine}")

    os_release = Path("/etc/os-release")
    if system == "Linux" and os_release.exists():
        info: dict[str, str] = {}
        for line in os_release.read_text().splitlines():
            if "=" in line:
                k, _, v = line.partition("=")
                info[k] = v.strip('"')
        if pretty := info.get("PRETTY_NAME"):
            print(f"Distro:      {pretty}")


def cmd_diff(args: list[str]) -> None:
    _exec_shell("_diff_files_interactive.sh", args)


def cmd_install_nvim(args: list[str]) -> None:
    if platform.system() != "Linux":
        print("Error: install-nvim is Linux-only. On macOS use: brew install neovim",
              file=sys.stderr)
        sys.exit(1)
    _exec_python("install_nvim.py", args)


def cmd_list_functions(args: list[str]) -> None:
    _exec_python("print_functions.py", args)


def cmd_debug(args: list[str]) -> None:
    _exec_shell("_run_with_xtrace.sh", args)

# ──────────────────────────────────────────────────────────────────────────────
# Registry
# ──────────────────────────────────────────────────────────────────────────────

COMMANDS: dict[str, tuple] = {
    "cleanup":        (cmd_cleanup,        "Clean up dotfiles, Homebrew, Neovim, tmux"),
    "ssh-keygen":     (cmd_ssh_keygen,     "Generate SSH keys with custom names/types"),
    "detect-os":      (cmd_detect_os,      "Detect current OS and architecture"),
    "diff":           (cmd_diff,           "Interactive file diff with tv and live watching"),
    "install-nvim":   (cmd_install_nvim,   "Install latest Neovim (Linux only)"),
    "list-functions": (cmd_list_functions, "List all custom zsh functions"),
    "debug":          (cmd_debug,          "Run a script with debug tracing (bash -x)"),
}

# ──────────────────────────────────────────────────────────────────────────────
# Help / Version
# ──────────────────────────────────────────────────────────────────────────────

def show_help() -> None:
    print(f"dutils v{VERSION} — Dotfiles Utility Tools\n")
    print("Usage: dutils <command> [options]\n")
    print("Commands:")
    for name, (_, desc) in COMMANDS.items():
        print(f"  \033[36m{name:<18}\033[0m {desc}")
    print(f"  \033[36m{'help':<18}\033[0m Show this help message")
    print(f"  \033[36m{'version':<18}\033[0m Show version information")
    print("\nFor command help:  dutils <command> --help")
    print("\nExamples:")
    print("  dutils cleanup nvim")
    print("  dutils ssh-keygen -e you@email.com")
    print("  dutils list-functions")
    print("  dutils debug script.sh")


def show_version() -> None:
    print(f"dutils version {VERSION}")
    print("Dotfiles utility tools by Akash Goyal")

# ──────────────────────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────────────────────

def main() -> None:
    if len(sys.argv) < 2:
        show_help()
        sys.exit(0)

    command = sys.argv[1]
    rest    = sys.argv[2:]

    if command in ("-h", "--help", "help"):
        show_help()
    elif command in ("-v", "--version", "version"):
        show_version()
    elif command in COMMANDS:
        COMMANDS[command][0](rest)
    else:
        print(f"Error: unknown command '{command}'\n", file=sys.stderr)
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
