VERSION    = "2.0.0"
# Resolve the symlink itself first, then take its parent - not the other way
# around. `dutils` is meant to be symlinked from ~/.local/bin (see README),
# and that directory is *itself* a symlink into this repo's bin/.local/bin/
# once the `bin` Stow package is applied (Stow symlinks the whole directory
# when the target doesn't exist yet, not just the files inside it). Resolving
# .parent first would follow that outer symlink instead of this file's own,
# landing SCRIPT_DIR in the wrong directory entirely (bin/.local/bin instead
# of scripts/dutils) and breaking every sibling-script lookup below.
# Force UTF-8 I/O so the box-drawing / ✓✗ glyphs printed by the verification
# and update subcommands don't crash on Windows, whose default console encoding
# (cp1252) can't encode them (UnicodeEncodeError). PYTHONIOENCODING is inherited
# by the Python scripts we exec below (check.py/update.py/cleanup.py print those
# glyphs); reconfigure() covers this process's own output. Both are no-ops where
# UTF-8 is already the default (macOS/Linux).
os.environ.setdefault("PYTHONIOENCODING", "utf-8")
try:
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
except (AttributeError, ValueError):
    pass

SCRIPT_DIR = Path(__file__).resolve().parent
# Sibling script directories under scripts/ - verification lives in verify/,
# shared OS-detect/logging libs in lib/. dutils reaches into both rather than
# duplicating their logic (e.g. detect-os uses lib/osdetect.py; the health/
# check/diagnose/sysinfo/packages commands all delegate to verify/check.py -
# the same implementation `make health` etc. use, now reachable on Windows too
# where there is no make).
VERIFY_DIR = SCRIPT_DIR.parent / "verify"
LIB_DIR    = SCRIPT_DIR.parent / "lib"

# ──────────────────────────────────────────────────────────────────────────────
# Dispatch helpers
# ──────────────────────────────────────────────────────────────────────────────

def _exec_python_at(path: Path, args: list[str]) -> None:
    """Replace the current process with a Python script at an explicit path."""
    if not path.exists():
        print(f"Error: script not found: {path}", file=sys.stderr)
        sys.exit(1)
    os.execvp(sys.executable, [sys.executable, str(path)] + args)


def _exec_python(script: str, args: list[str]) -> None:
    """Replace the current process with a Python script in SCRIPT_DIR."""
    _exec_python_at(SCRIPT_DIR / script, args)


def _exec_shell(script: str, args: list[str]) -> None:
    """Replace the current process with a shell script in SCRIPT_DIR.

    Invokes the interpreter explicitly (parsed from the script's own shebang)
    rather than exec'ing the script file directly and relying on the OS to
    honor the shebang line. Windows has no shebang support at all, so the
    latter always raised OSError: Exec format error — confirmed directly,
    regardless of whether bash/zsh were even installed. Explicit invocation
    works identically on every platform and doesn't depend on the file's
    executable bit either.
    """
    path = SCRIPT_DIR / script
    if not path.exists():
        print(f"Error: script not found: {path}", file=sys.stderr)
        sys.exit(1)

    interpreter = "bash"
    try:
        first_line = path.read_text(encoding="utf-8").splitlines()[0]
        if first_line.startswith("#!"):
            interpreter = Path(first_line[2:].split()[-1]).name
    except (OSError, IndexError):
        pass

    if shutil.which(interpreter) is None:
        print(f"Error: this command needs '{interpreter}', which isn't on PATH.\n"
              f"Native Windows PowerShell doesn't have it — use WSL2 (the "
              f"recommended daily-driver path for POSIX-shell tooling; see "
              f"docs/WINDOWS.md) or Git Bash instead.",
              file=sys.stderr)
        sys.exit(1)

    os.execvp(interpreter, [interpreter, str(path)] + args)

