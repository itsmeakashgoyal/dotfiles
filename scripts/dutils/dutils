# Help / Version
# ──────────────────────────────────────────────────────────────────────────────

def _current_platform() -> str:
    system = platform.system()
    if system == "Darwin":
        return "macos"
    if system == "Linux":
        return "linux"
    if system == "Windows":
        return "windows"
    return "macos"


# Rendering order for `--all` — narrowest-to-broadest doesn't matter as much
# as Cross-platform coming first, since that's most of the list.
_PLATFORM_GROUPS: list[tuple[tuple, str]] = [
    (ALL_PLATFORMS,      "Cross-platform"),
    (("macos", "linux"), "macOS + Linux (needs bash/zsh)"),
    (("macos",),         "macOS only"),
    (("linux",),         "Linux only"),
]


def show_help(show_all: bool = False) -> None:
    current = _current_platform()
    print(f"dutils v{VERSION} — Dotfiles Utility Tools\n")
    print("Usage: dutils <command> [options]\n")

    if show_all:
        print(f"Commands (all platforms — this machine is {current}):")
        for group_platforms, label in _PLATFORM_GROUPS:
            names = [n for n, (_, _, p) in COMMANDS.items() if p == group_platforms]
            if not names:
                continue
            print(f"\n  {label}:")
            for name in names:
                print(f"    \033[36m{name:<18}\033[0m {COMMANDS[name][1]}")
    else:
        print(f"Commands (for {current} — pass --all to see every platform):")
        for name, (_, desc, cmd_platforms) in COMMANDS.items():
            if current in cmd_platforms:
                print(f"  \033[36m{name:<18}\033[0m {desc}")

    print(f"\n  \033[36m{'help':<18}\033[0m Show this help message")
    print(f"  \033[36m{'version':<18}\033[0m Show version information")
    print("\nFor command help:  dutils <command> --help")
    print("\nExamples:")
    print("  dutils sync")
    print("  dutils update")
    print("  dutils health")
    print("  dutils edit nvim")
    print("  dutils new <package>")


def show_version() -> None:
    print(f"dutils version {VERSION}")
    print("Dotfiles utility tools by Akash Goyal")

# ──────────────────────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────────────────────

def main() -> None:
    if len(sys.argv) < 2:
        show_help()
        sys.exit(0)

    command  = sys.argv[1]
    rest     = sys.argv[2:]
    show_all = "--all" in sys.argv[1:] or "-a" in sys.argv[1:]

    if command in ("-h", "--help", "help", "--all", "-a"):
        show_help(show_all=show_all)
    elif command in ("-v", "--version", "version"):
        show_version()
    elif command in COMMANDS:
        COMMANDS[command][0](rest)
    else:
        print(f"Error: unknown command '{command}'\n", file=sys.stderr)
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
