# ──────────────────────────────────────────────────────────────────────────────
# Help / Version
# ──────────────────────────────────────────────────────────────────────────────

def show_help() -> None:
    print(f"dutils v{VERSION} — Dotfiles Utility Tools\n")
    print("Usage: dutils <command> [options]\n")
    print("Commands:")
    for name, (_, desc) in COMMANDS.items():
        print(f"  \033[36m{name:<18}\033[0m {desc}")
    print(f"  \033[36m{'help':<18}\033[0m Show this help message")
    print(f"  \033[36m{'version':<18}\033[0m Show version information")
    print("\nFor command help:  dutils <command> --help")
    print("\nExamples:")
    print("  dutils sync")
    print("  dutils update")
    print("  dutils health")
    print("  dutils edit nvim")
    print("  dutils new <package>")


def show_version() -> None:
    print(f"dutils version {VERSION}")
    print("Dotfiles utility tools by Akash Goyal")

# ──────────────────────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────────────────────

def main() -> None:
    if len(sys.argv) < 2:
        show_help()
        sys.exit(0)

    command = sys.argv[1]
    rest    = sys.argv[2:]

    if command in ("-h", "--help", "help"):
        show_help()
    elif command in ("-v", "--version", "version"):
        show_version()
    elif command in COMMANDS:
        COMMANDS[command][0](rest)
    else:
        print(f"Error: unknown command '{command}'\n", file=sys.stderr)
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
