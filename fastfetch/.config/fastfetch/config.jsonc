// ░▓▓▓▓▓▓▓▓▓▓
//
// Fastfetch system-info display: small logo, core system modules only
// (no extras like media player / public IP).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "battery",
        "locale",
        "colors"
    ]
}
