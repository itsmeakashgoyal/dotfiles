#
#  ▓▓▓▓▓▓▓▓▓▓
# ░▓ author ▓ Akash Goyal
# ░▓ file   ▓ git/.config/git/config
# ░▓▓▓▓▓▓▓▓▓▓
#
[init]
	defaultBranch = main

[user]
	# No identity in this tracked file on purpose: each machine gets its
	# identities from `dutils git-setup` (personal + any number of work
	# profiles, matched by folder / GitHub org / enterprise host), stored
	# OUTSIDE the repo in ~/.config/dotfiles/git/. Until that's run, git refuses
	# to commit instead of silently using the wrong email.
	useConfigOnly = true

# Generated per machine by `dutils git-setup` (see docs/SETUP.md). Missing file =
# silently ignored, so a fresh machine still works for everything but commits.
[include]
	path = ~/.config/dotfiles/git/config

# ============================================================================
# Aliases
# ============================================================================
[alias]
	s = status
	amend = commit --amend --reuse-message=HEAD
	# name <email> this repo commits as (see `dutils git-setup`)
	whoami = "!echo \"$(git config user.name) <$(git config user.email)>\""
	# Open the repo / its pull requests in the browser (gh)
	open = "!gh repo view --web"
	prs = "!gh pr list --web"

# ============================================================================
# Core Settings
# ============================================================================
[core]
	editor = nvim
	pager = delta
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	trustctime = false
	untrackedCache = true
	autocrlf = input
	safecrlf = warn
	# Built-in filesystem watcher (git >=2.37, no external Watchman needed):
	# `git status`/diff-index normally stat every tracked file on every call,
	# which is what makes starship's git_status module slow-to-timeout on
	# large repos (esp. on Windows, where stats are pricier and AV adds more
	# overhead per file touched). fsmonitor lets git skip that full walk by
	# tracking changes incrementally instead.
	fsmonitor = true

# feature.manyFiles bundles good defaults for large repos (smaller index
# format, faster index writes) on top of untrackedCache/fsmonitor above.
[feature]
	manyFiles = true

[apply]
	whitespace = fix

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[commit]
	verbose = true

[color]
	ui = auto

# ============================================================================
# Delta (diff viewer)
# ============================================================================
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	# No syntax-theme here: delta reads $BAT_THEME (gruvbox-dark/-light, set
	# by the shell from `dutils theme`), so diffs match the terminal.

[interactive]
	diffFilter = delta --color-only

# ============================================================================
# Diff & Merge
# ============================================================================
[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies
	mnemonicprefix = true

[difftool]
	prompt = false

[merge]
	log = true
	conflictStyle = zdiff3
	tool = nvimdiff

[mergetool]
	prompt = false
	keepBackup = false

# ============================================================================
# Push, Pull & Fetch
# ============================================================================
[push]
	default = current
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[fetch]
	prune = true

# ============================================================================
# Utilities
# ============================================================================
[rerere]
	enabled = true
	autoUpdate = true

[grep]
	extendRegexp = true
	lineNumber = true

[help]
	autocorrect = prompt

# ============================================================================
# GitHub Integration
# ============================================================================
[url "git@github.com:"]
	insteadOf = "gh:"

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
