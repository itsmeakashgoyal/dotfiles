#
#  ▓▓▓▓▓▓▓▓▓▓
# ░▓ author ▓ Akash Goyal
# ░▓ file   ▓ .gitignore
# ░▓▓▓▓▓▓▓▓▓▓
#
.DS_Store
**/.DS_Store

# Zsh generated files
**/.zcompdump
**/.zcompdump-*
**/.zsh_history
**/.zsh_sessions/

# Caches (keep repo clean)
.cache/

# Compiled Python files
*.pyc
__pycache__/

# Folder view configuration files
*.swp
.vscode
.cursor/rules

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Tmux plugins (managed by TPM)
tmux/.config/tmux/plugins/*

# Nix build artifacts (NOTE: keep nix/flake.lock tracked — it pins versions)
result
result-*
nix/result
nix/result-*

# Private Information — machine-local work exports/secrets (never committed)
private/*
zsh/.config/zsh/conf.d/99-private.zsh
windows/powershell/Documents/PowerShell/profile.d/99-private.ps1
.claude/
.codex/
.scout/

# Legacy machine-local git identity files. Identities now live OUTSIDE the repo
# in ~/.config/dotfiles/git/ (see `dutils git-setup`); `dutils git-setup
# migrate` imports these and they can then be deleted.
git/.config/git/config-local
git/.config/git/config-personal

# iTerm2 is configured through a Dynamic Profile (settings/iterm/profile.json,
# rendered by `dutils theme`). The full preferences plist is no longer synced:
# it changes on every launch and hardcodes the username.
settings/iterm/*.plist
settings/iterm/*.itermexport

# Compiled zsh bytecode (dutils zcompile) — regenerated per machine
**/*.zwc
