.DS_Store
**/.DS_Store

# Zsh generated files
**/.zcompdump
**/.zcompdump-*
**/.zsh_history
**/.zsh_sessions/

# Caches (keep repo clean)
.cache/

# Compiled Python files
*.pyc

# Folder view configuration files
*.swp
.vscode
.cursor/rules

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Tmux plugins (managed by TPM)
tmux/.config/tmux/plugins/*

# Nix build artifacts (NOTE: keep nix/flake.lock tracked — it pins versions)
result
result-*
nix/result
nix/result-*

# Private Information
private/*
zsh/.config/zsh/conf.d/99-private.zsh
.claude/
