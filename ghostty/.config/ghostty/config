#
# Zenbones Dark (forced - not tied to the macOS light/dark appearance, so it
# stays dark like the reference screenshot even when macOS is in light mode).
theme = Zenbones Dark

# JetBrainsMono Nerd Font with its OpenType stylistic sets + ligatures enabled -
# ss01-ss10 swap in the alternate letterforms, `zero` slashes the zero, and
# calt/liga turn on ligatures. font-thicken bolds the strokes slightly. This is
# what gives the distinctive look (same font family, different glyph shapes).
font-family   = JetBrainsMono Nerd Font Mono
font-size     = 18
font-thicken  = true
font-feature  = zero
font-feature  = ss01
font-feature  = ss02
font-feature  = ss03
font-feature  = ss04
font-feature  = ss05
font-feature  = ss06
font-feature  = ss07
font-feature  = ss08
font-feature  = ss09
font-feature  = ss10
font-feature  = calt
font-feature  = liga

# A touch more breathing room between lines/cells.
adjust-cell-height = 15%
adjust-cell-width  = 2%

# Animated "smear" cursor (shader vendored in this dir; see its header for the
# upstream author). Relative path resolves against this config's directory.
custom-shader = cursor.glsl

# Shell integration is native (Ghostty injects it itself before exec'ing the
# shell) - no sourcing required, unlike iTerm2's file-based approach in
# zsh/.config/zsh/conf.d/16-iterm.zsh. `detect` (the default) autodetects zsh.
shell-integration = detect

# Matches the "leave close-confirmation off" choice already made for iTerm2
# (see settings/iterm/com.googlecode.iterm2.plist's "Prompt Before Closing").
confirm-close-surface = false

# Quality-of-life additions (theme/font left as-is):
# - Hide the mouse cursor while typing so it doesn't sit over text.
# - A little breathing room around the grid (x = left,right ; y = top,bottom).
mouse-hide-while-typing = true
window-padding-x = 4,0
window-padding-y = 2,0

# CSI-u keybinds so ctrl+enter / shift+enter send distinct sequences instead of
# a plain newline - TUIs and editors (Neovim, REPLs, Claude Code) can then bind
# them separately (e.g. shift+enter for a soft newline).
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# Opt-in: treat the macOS Option key as a real Alt modifier (enables alt+<key>
# bindings). Uncomment ONLY if you don't rely on Option to type special
# characters (é, ©, √, …) - it disables that when on.
# macos-option-as-alt = true

# Quick Terminal: a global hotkey drops down a terminal overlay from any app,
# no window-switching needed - iTerm2 has the same idea ("Hotkey Window") but
# it isn't set up in this profile (Has Hotkey = False). Bound to Option+` (not
# Cmd+`, which macOS already reserves system-wide for cycling windows within
# the frontmost app - binding over that would break that shortcut everywhere,
# not just in Ghostty).
keybind = global:opt+grave_accent=toggle_quick_terminal

# Everything below is a default already active, not a change - noted here so
# it doesn't look accidental:
# - Metal-accelerated rendering (this build: renderer.generic.Renderer(Metal))
#   gives noticeably lower input-to-frame latency than iTerm2's renderer -
#   directly relevant after this session's Starship/prompt-latency work.
# - clipboard-paste-protection / clipboard-paste-bracketed-safe guard against
#   pasted text smuggling in control sequences or looking like more lines of
#   input than it appears to be - not something iTerm2 does by default.
# - Config changes reload live (no restart) via the default Cmd+Shift+,
#   keybind (reload_config action) - no equivalent in iTerm2 without
#   reopening the affected window/tab.
