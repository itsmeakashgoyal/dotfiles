{
    "name": "Gruvbox Dark",
    "author": "Akash Goyal",
    "variables": {
        "bg": "#282828",
        "bg1": "#3c3836",
        "bg2": "#504945",
        "bg3": "#665c54",
        "fg": "#ebdbb2",
        "fg4": "#a89984",
        "gray": "#928374",
        "red": "#fb4934",
        "green": "#b8bb26",
        "yellow": "#fabd2f",
        "blue": "#83a598",
        "purple": "#d3869b",
        "aqua": "#8ec07c",
        "orange": "#fe8019"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(fg)",
        "block_caret": "var(fg)",
        "line_highlight": "var(bg1)",
        "selection": "var(bg2)",
        "selection_border": "var(bg3)",
        "inactive_selection": "#3a3735",
        "misspelling": "var(red)",
        "find_highlight": "var(yellow)",
        "find_highlight_foreground": "var(bg)",
        "gutter": "var(bg)",
        "gutter_foreground": "#7c6f64",
        "line_diff_added": "var(green)",
        "line_diff_modified": "var(yellow)",
        "line_diff_deleted": "var(red)",
        "guide": "#3a3634",
        "active_guide": "var(bg3)",
        "stack_guide": "#3a3634"
    },
    "rules": [
        { "scope": "comment", "foreground": "var(gray)", "font_style": "italic" },
        { "scope": "string", "foreground": "var(green)" },
        { "scope": "constant.numeric", "foreground": "var(purple)" },
        { "scope": "constant.language", "foreground": "var(purple)" },
        { "scope": "constant.character, constant.other", "foreground": "var(purple)" },
        { "scope": "keyword, keyword.control", "foreground": "var(red)" },
        { "scope": "keyword.operator", "foreground": "var(orange)" },
        { "scope": "storage.type", "foreground": "var(yellow)" },
        { "scope": "storage.modifier", "foreground": "var(red)" },
        { "scope": "entity.name.function, support.function, variable.function", "foreground": "var(green)", "font_style": "bold" },
        { "scope": "entity.name.class, entity.name.type, entity.name.namespace, support.class, support.type", "foreground": "var(yellow)" },
        { "scope": "entity.name.tag", "foreground": "var(red)" },
        { "scope": "entity.other.attribute-name", "foreground": "var(aqua)" },
        { "scope": "variable, variable.other", "foreground": "var(fg)" },
        { "scope": "variable.parameter", "foreground": "var(fg)" },
        { "scope": "variable.language", "foreground": "var(purple)", "font_style": "italic" },
        { "scope": "support.constant, support.variable", "foreground": "var(purple)" },
        { "scope": "punctuation, meta.brace, punctuation.section", "foreground": "var(fg4)" },
        { "scope": "punctuation.definition.comment", "foreground": "var(gray)" },
        { "scope": "invalid", "foreground": "var(bg)", "background": "var(red)" },
        { "scope": "markup.heading", "foreground": "var(green)", "font_style": "bold" },
        { "scope": "markup.bold", "foreground": "var(orange)", "font_style": "bold" },
        { "scope": "markup.italic", "foreground": "var(purple)", "font_style": "italic" },
        { "scope": "markup.underline.link", "foreground": "var(aqua)" },
        { "scope": "markup.inserted", "foreground": "var(green)" },
        { "scope": "markup.deleted", "foreground": "var(red)" },
        { "scope": "markup.changed", "foreground": "var(yellow)" },
        { "scope": "markup.raw.inline, markup.raw.block", "foreground": "var(aqua)" }
    ]
}
