{
    "name": "Tokyo Night",
    "author": "Akash Goyal",
    "variables": {
        "bg": "#1a1b26",
        "bg_highlight": "#292e42",
        "fg": "#c0caf5",
        "fg_dark": "#a9b1d6",
        "comment": "#565f89",
        "selection": "#283457",
        "gutter_fg": "#3b4261",
        "blue": "#7aa2f7",
        "cyan": "#7dcfff",
        "teal": "#73daca",
        "green": "#9ece6a",
        "yellow": "#e0af68",
        "orange": "#ff9e64",
        "red": "#f7768e",
        "purple": "#bb9af7",
        "magenta": "#bb9af7"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(fg)",
        "block_caret": "var(fg)",
        "line_highlight": "var(bg_highlight)",
        "selection": "var(selection)",
        "selection_border": "var(selection)",
        "inactive_selection": "#20222e",
        "misspelling": "var(red)",
        "find_highlight": "var(yellow)",
        "find_highlight_foreground": "var(bg)",
        "gutter": "var(bg)",
        "gutter_foreground": "var(gutter_fg)",
        "line_diff_added": "var(green)",
        "line_diff_modified": "var(yellow)",
        "line_diff_deleted": "var(red)",
        "guide": "#2a2e3f",
        "active_guide": "#3b4261",
        "stack_guide": "#2a2e3f"
    },
    "rules": [
        { "scope": "comment", "foreground": "var(comment)", "font_style": "italic" },
        { "scope": "string", "foreground": "var(green)" },
        { "scope": "constant.numeric", "foreground": "var(orange)" },
        { "scope": "constant.language", "foreground": "var(orange)" },
        { "scope": "constant.character, constant.other", "foreground": "var(orange)" },
        { "scope": "keyword, keyword.control", "foreground": "var(purple)" },
        { "scope": "keyword.operator", "foreground": "var(teal)" },
        { "scope": "storage, storage.type, storage.modifier", "foreground": "var(purple)" },
        { "scope": "entity.name.function, support.function", "foreground": "var(blue)" },
        { "scope": "entity.name.class, entity.name.type, entity.name.namespace, support.class, support.type", "foreground": "var(cyan)" },
        { "scope": "entity.name.tag", "foreground": "var(red)" },
        { "scope": "entity.other.attribute-name", "foreground": "var(yellow)" },
        { "scope": "variable, variable.other", "foreground": "var(fg)" },
        { "scope": "variable.parameter", "foreground": "var(orange)" },
        { "scope": "variable.language", "foreground": "var(red)", "font_style": "italic" },
        { "scope": "variable.function", "foreground": "var(blue)" },
        { "scope": "support.constant, support.variable", "foreground": "var(cyan)" },
        { "scope": "punctuation, meta.brace, punctuation.section", "foreground": "var(fg_dark)" },
        { "scope": "punctuation.definition.comment", "foreground": "var(comment)" },
        { "scope": "invalid", "foreground": "var(bg)", "background": "var(red)" },
        { "scope": "markup.heading", "foreground": "var(blue)", "font_style": "bold" },
        { "scope": "markup.bold", "foreground": "var(orange)", "font_style": "bold" },
        { "scope": "markup.italic", "foreground": "var(purple)", "font_style": "italic" },
        { "scope": "markup.underline.link", "foreground": "var(teal)" },
        { "scope": "markup.inserted", "foreground": "var(green)" },
        { "scope": "markup.deleted", "foreground": "var(red)" },
        { "scope": "markup.changed", "foreground": "var(yellow)" },
        { "scope": "markup.raw.inline, markup.raw.block", "foreground": "var(teal)" }
    ]
}
